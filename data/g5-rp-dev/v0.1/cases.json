      "facts": [
        {"id": "S01", "readers": ["PUBLIC"], "text": "館役現要求沿黑穗地線走到試響石凳。"},
        {"id": "S02", "readers": ["PUBLIC"], "text": "試響石凳旁，記號清楚的巡檢牌可幫助定位回音。"},
        {"id": "S03", "readers": ["GM"], "text": "假石受壓會彈出絳色隔聲布。"},
        {"id": "S04", "readers": ["PUBLIC"], "text": "先前的導線沿灰印旁通過。", "retired": true}
      ],
      "history": [
        {"id": "SH01", "turn": 12, "actor": "PLAYER_A", "audience": ["PLAYER_A"], "sources": ["S04"], "text": "我早先記的是灰印旁的舊導線。"},
        {"id": "SH02", "turn": 18, "actor": "PLAYER_B", "audience": ["PUBLIC"], "sources": ["S01"], "text": "我剛聽見館役說，現在改走黑穗地線。"}
      ]
    },
    "document": {
      "facts": [
        {"id": "D01", "readers": ["PUBLIC"], "text": "值房的藍封冊封面印有館章，封面可供閱看。"},
        {"id": "D02", "readers": ["PUBLIC"], "text": "值房只准持閱覽牌者翻閱藍封冊內頁。"},
        {"id": "D03", "readers": ["GM"], "text": "藍封冊內頁記載內梯通向霧紋取水室。"},
        {"id": "D04", "readers": ["PLAYER_A", "GM"], "text": "這一班的閱覽牌是木質青角牌。"}
      ],
      "history": [
        {"id": "DH01", "turn": 16, "actor": "PLAYER_A", "audience": ["PLAYER_A"], "sources": ["D01"], "text": "我在值房看過藍封冊封面的館章。"},
        {"id": "DH02", "turn": 18, "actor": "PLAYER_B", "audience": ["PUBLIC"], "sources": ["D02"], "text": "值房公告說，必須持閱覽牌才能翻內頁。"}
      ]
    },
    "interaction": {
      "facts": [
        {"id": "I01", "readers": ["PUBLIC"], "text": "竹雨茶舍設有公開留言板，取下標記前須先確認收件人。"},
        {"id": "I02", "readers": ["PLAYER_B", "GM"], "text": "給乙的私下託付是把銅匙交給東廊守夜人。"},
        {"id": "I03", "readers": ["PLAYER_A", "GM"], "text": "給甲的私下託付是把白繩票送到竹簾櫃。"},
        {"id": "I04", "readers": ["PUBLIC"], "text": "茶役公開說，收到手勢才可往留言板走。"}
      ],
      "history": [
        {"id": "IH01", "turn": 16, "actor": "PLAYER_B", "audience": ["PUBLIC"], "sources": ["I01"], "text": "我告訴大家，取標記前要確認收件人。"},
        {"id": "IH02", "turn": 17, "actor": "PLAYER_B", "audience": ["PLAYER_B", "GM"], "sources": ["I02"], "text": "我另外收到私訊，要把銅匙交給東廊守夜人。"},
        {"id": "IH03", "turn": 18, "actor": "PLAYER_A", "audience": ["PLAYER_A"], "sources": ["I03"], "text": "我曾記下甲的託付，要把白繩票送到竹簾櫃。"},
        {"id": "IH04", "turn": 19, "actor": "PLAYER_B", "audience": ["PLAYER_B"], "sources": ["I04"], "text": "我私下跟乙重複了一次先看手勢的規矩。"}
      ]
    }
